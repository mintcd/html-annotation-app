{
  "name": "@mintcd/html-annotation-app",
  "type": "module",
  "private": true,
  "scripts": {
    "sync": "sync-engine-vinext generate",
    "sync:check": "sync-engine-vinext generate --check",
    "cf:typegen": "wrangler types",
    "prebuild": "npm run sync",
    "dev": "vinext dev --port 5001 --host 0.0.0.0",
    "pretypecheck": "vinext typegen",
    "typecheck": "tsc --noEmit",
    "build": "vinext build",
    "deploy": "npx @vinext/cloudflare deploy",
    "start": "vinext start",
    "lint": "vinext lint",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@mintcd/sync-engine": "^2.2.0",
    "@mintcd/sync-engine-vinext": "^1.0.0",
    "cheerio": "^1.0.0",
    "framer-motion": "^12.23.22",
    "katex": "^0.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.5.0",
    "styled-components": "^6.1.19",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@next/eslint-plugin-next": "16.1.6",
    "@types/cors": "^2.8.17",
    "@types/node": "^20",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vinext/cloudflare": "^1.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.38",
    "baseline-browser-mapping": "^2.11.0",
    "eslint": "^9",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "miniflare": "5.20261019.2-beta",
    "react-server-dom-webpack": "^19.3.1",
    "typescript": "^5",
    "typescript-eslint": "^8.56.1",
    "vinext": "^1.3.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
